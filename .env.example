# Fulkrum environment configuration
#
# Copy this file to .env.local and add only what you need:
#   Copy-Item .env.example .env.local     (PowerShell)
#   cp .env.example .env.local            (bash)
#
# Every value here is read by the local API bridge only. API keys are never
# bundled into the browser build and are never returned by the status endpoint.
# Restart `npm run dev` after changing this file.

# --- Provider API keys -------------------------------------------------------
# Each role routes to a provider; a provider without a key runs in demo mode.
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=
ZAI_API_KEY=
KIMI_API_KEY=
MOONSHOT_API_KEY=

# --- Model overrides ---------------------------------------------------------
# A route that names an explicit model wins; these set each provider's default
# model for routes that do not.
FULKRUM_GROK_MODEL=grok-4
FULKRUM_OPENAI_MODEL=gpt-5
FULKRUM_ANTHROPIC_MODEL=claude-opus-4-1
FULKRUM_GOOGLE_MODEL=gemini-2.5-pro
FULKRUM_DEEPSEEK_MODEL=deepseek-chat
FULKRUM_GLM_MODEL=glm-4.5
FULKRUM_KIMI_MODEL=kimi-k2

# Ordered fallback routes, tried when the primary provider fails after retries.
# Comma-separated "Provider label · model" values.
# FULKRUM_FALLBACK_ROUTES=OpenAI · gpt-5,Google · gemini-2.5-pro

# --- Local API bridge --------------------------------------------------------
# The bridge binds 127.0.0.1 only. It is never exposed to the network.
FULKRUM_API_PORT=8787

# Workspace root the agent tools may touch. Defaults to the process working
# directory. Paths outside it are refused.
# FULKRUM_WORKSPACE_ROOT=D:\projects\fulkrum

# --- Persistence -------------------------------------------------------------
# A database file, or a directory containing fulkrum.sqlite.
# FULKRUM_DB_PATH=./data/fulkrum.sqlite
# FULKRUM_DATA_DIR=./data

# --- Security policy ---------------------------------------------------------
# Browser origins allowed to call the API. Non-browser clients (curl, scripts)
# send no Origin header and are always allowed; a browser page on any other
# origin is refused with 403. Vite's preview server uses port 4173, so add it
# here if you run `npm run preview`.
FULKRUM_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Host allowlist for the http.request tool. Default deny: with this unset the
# tool requires explicit approval every time. Comma-separated hostnames;
# subdomains of a listed host are allowed.
# FULKRUM_HTTP_ALLOWLIST=api.example.com,docs.example.com

# Custom provider URLs must use a public host, because loopback and private
# network targets are blocked to stop the agent from reaching services on your
# own machine. Set this to 1 to allow a local model gateway such as Ollama.
# FULKRUM_ALLOW_PRIVATE_PROVIDER_URLS=1

# --- Budgets -----------------------------------------------------------------
# Hard ceilings in US dollars. A run stops in a budget_exceeded state instead of
# silently spending more, and the control room offers to raise the ceiling and
# continue. Unset means no ceiling. A budget only works for models whose price is
# known: unpriced calls are reported as "cost unknown" rather than counted as
# free, and the run says so.
# FULKRUM_RUN_BUDGET_USD=2.00
# FULKRUM_DAILY_BUDGET_USD=10.00

# Where prices live. The built-in table is approximate published list pricing and
# is meant to be corrected for the models you use: point this at a JSON file of
# the same shape (model -> {input, output, cacheRead, cacheWrite} in USD per
# million tokens) to override entries without editing code.
# FULKRUM_PRICE_FILE=./prices.json

# --- Agent loop --------------------------------------------------------------
# How many tool calls a worker may make on one task before it must summarise.
# FULKRUM_MAX_TOOL_STEPS=8

# Files longer than this are not diffed in the artifacts view; the change is
# reported as too large to diff rather than dumped in full.
# FULKRUM_MAX_DIFF_LINES=2000

# How much of a file's previous contents are kept so its change can be reviewed.
# Larger files keep their size and hash but not their bytes.
# FULKRUM_MAX_SNAPSHOT_BYTES=64000

# Read-only research tasks may run this many at a time. Tasks that can write are
# always serialized, because parallel writers conflict over the same files.
# FULKRUM_MAX_PARALLEL_RESEARCHERS=3

# Upper bound on a single model reply.
# FULKRUM_MAX_OUTPUT_TOKENS=4096

# Per-request provider timeout, and how many attempts a retryable failure gets.
# FULKRUM_PROVIDER_TIMEOUT_MS=60000
# FULKRUM_PROVIDER_MAX_ATTEMPTS=3

# --- Retention ---------------------------------------------------------------
# Tool outputs are the bulkiest audit data and are pruned first. Run events are
# hash-chained and retained indefinitely: deleting one would break the chain.
# FULKRUM_TOOL_OUTPUT_RETENTION_DAYS=14
