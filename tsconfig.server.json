{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,

    /* Not strict yet: the server is untyped JavaScript, and the value here is
       catching misspelled identifiers, wrong argument counts, and unknown
       properties rather than annotating everything. Strictness can follow. */
    "strict": false,
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["server/**/*.mjs", "tests/**/*.mjs"]
}
