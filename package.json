{
  "name": "fulkrum",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "bin": {
    "fulkrum": "bin/fulkrum.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node --watch --env-file-if-exists=.env.local server/index.mjs",
    "start": "node bin/fulkrum.mjs",
    "api": "node --env-file-if-exists=.env.local server/index.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:watch": "node --test --watch \"tests/**/*.test.mjs\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=75 --test-coverage-functions=85 --test-coverage-exclude=tests/** --test-coverage-exclude=src/** --test-coverage-exclude=server/runner/** --test-coverage-exclude=scripts/** \"tests/**/*.test.mjs\"",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "audit:verify": "node --env-file-if-exists=.env.local server/verifyAudit.mjs",
    "db:backup": "node --env-file-if-exists=.env.local server/backup.mjs",
    "build": "tsc -b && vite build",
    "runner:build": "docker build --tag fulkrum-runner:local server/runner",
    "lint": "oxlint"
  },
  "dependencies": {
    "lucide-react": "^1.46.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
